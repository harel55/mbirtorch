# IDE / harness local state
.idea/
.claude/*.json
__pycache__/
*.pyc
.pytest_cache/
.vscode/

# build artifacts
build/
dist/
*.egg-info/

# local outputs (mirrors the mbirjax convention: results/ and output/ are
# per-machine scratch; numbers that drive decisions go into committed prose)
output/
results/
logs/

# cross-framework golden data: generated on demand by tests/generate_goldens.py
# (run in the mbirjax env); binary, regenerable, so not committed
tests/goldens/

# environments
.venv/

# scratch from dev_scripts/refresh_widening_floors.py (staged sinograms, arm rows)
dev_scripts/_widening_floor_runs/
